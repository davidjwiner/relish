# Set by `pnpm dev:backend` after selecting a Convex development deployment.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
# Backend-only settings (set in the Convex dashboard, NOT in Vite):
# SITE_URL=http://localhost:5173
# AUTH_GOOGLE_ID
# AUTH_GOOGLE_SECRET
# JWT_PRIVATE_KEY
# JWKS
# EXA_API_KEY (required by the Exa component; configure in Convex)
# PREFERENCE_EXTRACTION_ENABLED=true (enable after running the backfill)

# BROWSERBASE_API_KEY (backend-only; enables the browser tool)
# BROWSERBASE_PROJECT_ID (optional; otherwise inferred by Browserbase)

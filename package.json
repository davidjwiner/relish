{
  "name": "relish",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host localhost",
    "dev:backend": "convex dev",
    "setup:backend": "convex dev --configure",
    "setup:auth": "auth --skip-git-check --web-server-url http://localhost:5173",
    "codegen": "convex codegen",
    "typecheck": "tsc --noEmit && tsc --noEmit -p convex/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "pnpm typecheck && vite build",
    "deploy": "static-hosting deploy --build-command 'pnpm build'",
    "preview": "vite preview --host localhost",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.18",
    "@assistant-ui/react-markdown": "^0.14.14",
    "@auth/core": "0.41.1",
    "@convex-dev/agent": "^0.7.2",
    "@convex-dev/ai-sdk-provider": "0.2.0-alpha.1",
    "@convex-dev/auth": "0.0.95",
    "@convex-dev/static-hosting": "0.2.1",
    "@convex-dev/workflow": "^0.4.6",
    "@exalabs/convex-exa": "^0.1.1",
    "ai": "^7.0.93",
    "convex": "1.45.0",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@convex-dev/eslint-plugin": "^4.0.0",
    "@edge-runtime/vm": "^5.0.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.56",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
